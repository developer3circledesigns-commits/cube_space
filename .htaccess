RewriteEngine On

# Block sensitive directories
RewriteRule ^(config|lib|src|logs|vendor)(/|$) - [F,L]

# Block sensitive files at repo root
RewriteRule \.(env|gitignore|dockerignore)$ - [F,L]
RewriteRule ^(Dockerfile|docker-compose\.yml|php\.ini|httpd\.conf|README\.md|composer\.(json|lock))$ - [F,L]
RewriteRule ^.*\.sql$ - [F,L]

# Block sensitive debug files
RewriteRule ^test_db\.php$ - [F,L]

# Pass Authorization header to PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Redirect Trailing Slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Force clean URLs (strip .php extension via external redirect — skip POST to avoid data loss)
RewriteCond %{REQUEST_METHOD} !POST [NC]
RewriteCond %{THE_REQUEST} \.php[\s?/] [NC]
RewriteCond %{REQUEST_URI} !^/serve_image [NC]
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.php$ /$1 [L,R=301]

# Security headers (allow same-origin framing; block foreign embeds)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Ensure index.php is recognized
DirectoryIndex index.php

# Disable directory listing & MultiViews (avoids Apache exposing .php via content negotiation)
Options -Indexes -MultiViews

# === PERFORMANCE: Browser Caching ===
<IfModule mod_expires.c>
    ExpiresActive On

    # Default: 1 month
    ExpiresDefault "access plus 1 month"

    # HTML, PHP: 0 seconds (no cache)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS, JS: 1 year (cache-bust via v= query param)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images: 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts: 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# === PERFORMANCE: Cache-Control Headers ===
<IfModule mod_headers.c>
    # CSS, JS, images, fonts: cache for 1 year with immutable
    <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # HTML, PHP: no-cache
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    </IfModule>

# === PERFORMANCE: Enable Compression ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/ttf font/otf
</IfModule>

# === PERFORMANCE: Set Keep-Alive ===
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>


# Hide .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
# Deny access to all files by default
<FilesMatch ".*">
    Require all denied
</FilesMatch>

# Only allow specific image types
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
    Require all granted
</FilesMatch>

# Disable PHP engine
php_flag engine off

# Prevent script execution
AddType text/plain .php .phtml .php3 .php4 .php5 .phps .pht .phar
AddType text/plain .pl .py .jsp .asp .sh .cgi .htaccess

# Disable directory listing
Options -Indexes
